<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" />
    <PackageReference Include="CliWrap" />
    <PackageReference Include="Keyfactor.Orchestrators.IOrchestratorJobExtensions" />
    <PackageReference Include="Keyfactor.PKI" />
    <PackageReference Include="Microsoft.PowerShell.SDK" />
    <PackageReference Include="SSH.NET" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\..\RemoteFile\**\*.cs" Exclude="..\..\..\RemoteFile\bin\**;..\..\..\RemoteFile\obj\**" Link="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\RemoteFile\config.json" Link="config.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="manifest.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
